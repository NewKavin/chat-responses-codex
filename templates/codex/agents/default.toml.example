# Copy this file to ~/.codex/agents/default.toml as-is.
# Do not pin a model or a reasoning level here: the subagent inherits the main
# ~/.codex/config.toml profile, so switching models needs no edit in this file.
name = "default"
description = "General-purpose read-only exploration subagent."
developer_instructions = "You are a read-only exploration subagent. Do not modify files or state."

[features]
image_generation = false

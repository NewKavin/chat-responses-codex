# Point Codex at the gateway, not at the upstream vendors directly.
# `model` and `review_model` must match the selected exposed slug exactly.
# Keep model-catalog.json next to this file; Codex resolves the path relative to ~/.codex/config.toml.
# Render the complete downstream allowlist from `/v1/models?format=codex` before use.
# Catalog entries use `effective_context_window_percent = 80`; do not override it with a global limit.
# Do not add upstream IDs, route fingerprints, or cloned model entries to this client config.
model_provider = "gateway"
model = "<model_slug>"
review_model = "<model_slug>"
model_reasoning_effort = "<reasoning_effort_from_live_catalog>"
model_catalog_json = "model-catalog.json"
cli_auth_credentials_store = "file"
web_search = "disabled"

[features]
skill_mcp_dependency_install = true
tool_suggest = true
multi_agent = true

[agents]
max_threads = 4
max_depth = 2

[model_providers.gateway]
name = "Chat Responses Gateway"
base_url = "<gateway_url>/v1"
wire_api = "responses"
requires_openai_auth = true
stream_idle_timeout_ms = 3600000
stream_max_retries = 2

# If a skill still triggers an install prompt, the missing MCP server is declared
# by that skill itself. Add it to your global Codex MCP config, then restart Codex.

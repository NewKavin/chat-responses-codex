# 复制此文件为 `.env` 后再启动 `docker compose`。
# 这里只保留启动连接、凭据和基础设施参数；行为调优请在管理端 Settings 页面保存。
# 生产环境请使用强密码和唯一密钥。

# PostgreSQL 数据库密码，网关连接数据库时使用。
POSTGRES_PASSWORD=replace-this-with-a-strong-password
# PostgreSQL 连接串；设置后使用数据库模式。
DATABASE_URL=postgres://chat_responses_codex@postgres/chat_responses_codex
# PostgreSQL 连接池最大连接数。
POSTGRES_POOL_MAX_SIZE=16

# 管理员登录凭据和 JWT 签名密钥。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-strong-password
JWT_SECRET=replace-this-with-a-strong-secret-at-least-32-characters

# 网关监听地址和文件兼容模式状态路径。
BIND_ADDR=0.0.0.0:3001
STATE_PATH=/data/state.json

# 运行日志路径、级别和时区。
LOG_PATH=/logs/chat-responses-codex.log
RUST_LOG=info
TZ=Asia/Shanghai
# 日志轮转策略: never | hourly | daily | minutely (tracing-appender)。默认 daily；最多保留 LOG_ROTATION_MAX_FILES 个旧文件。
LOG_ROTATION=daily
LOG_ROTATION_MAX_FILES=14


# 可选 Redis 运行时协调。单实例部署保持关闭。
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
# 同一 Redis 中不同部署必须使用不同前缀；仅允许字母、数字、冒号、下划线和连字符。
REDIS_KEY_PREFIX=chat2responses

# 可选：容器内的 PEM bundle 文件或包含 .crt/.pem 内部 CA 的目录。
UPSTREAM_CA_CERT_PATH=
# 仅在 capability policy revision 为 0 时加载仓库内置部署策略。
CAPABILITY_POLICY_BOOTSTRAP_ON_ZERO=true
